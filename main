#!/bin/bash
set -e

# Brainlife stages inputs as relative paths (../task_id/dataset_id/file).
# Singularity only mounts the current directory, so resolve every file-type
# config value to an absolute path before any container call.
for _key in t1 freesurfer fivett tractogram dwi bvec bval eccentricity varea \
            lgn_lh lgn_rh v1_lh v1_rh rois response \
            lmax2 lmax4 lmax6 lmax8 lmax10 lmax12 lmax14; do
    _val=$(jq -r --arg k "$_key" '.[$k] // empty' config.json)
    if [ -n "$_val" ] && [ -e "$_val" ]; then
        _abs=$(realpath "$_val")
        jq --arg k "$_key" --arg v "$_abs" '.[$k] = $v' config.json \
            > /tmp/_cfg.json && mv /tmp/_cfg.json config.json
    fi
done

# Parent directory contains all brainlife input task directories;
# bind it with the same absolute path inside every singularity call.
PARENT_DIR=$(realpath ..)

FIVETT=$(jq -r '.fivett // empty' config.json)
TRACTOGRAM=$(jq -r '.tractogram // empty' config.json)
T1=$(jq -r '.t1' config.json)
FREESURFER=$(jq -r '.freesurfer' config.json)
NTHREADS=$(jq -r '.nthreads // 1' config.json)
FORCE=$(jq -r '.force // false' config.json)
LGN_LH=$(jq -r '.lgn_lh // empty' config.json)
WORK_DIR=$(jq -r '.work_dir // "work"' config.json)
OUTPUT_DIR=$(jq -r '.output_dir // "."' config.json)

# Auto-run thalamic nuclei segmentation if LGN ROIs are not provided
if [ -z "$LGN_LH" ]; then
    THAL_MGZ="${FREESURFER}/mri/ThalamicNuclei.v12.T1.FSvoxelSpace.mgz"
    if [ ! -f "$THAL_MGZ" ] || [ "$FORCE" == "true" ]; then
        echo "[main] ThalamicNuclei.v12.T1.FSvoxelSpace.mgz not found — running segmentThalamicNuclei.sh"
        [ -z "$FREESURFER_LICENSE" ] && echo "[ERROR] FREESURFER_LICENSE env var not set" && exit 1
        cat "$FREESURFER_LICENSE" > license.txt
        mkdir -p "${WORK_DIR}/freesurfer_subject"
        cp -R "${FREESURFER}"/* "${WORK_DIR}/freesurfer_subject/"
        singularity exec -e \
            --bind "${PARENT_DIR}:${PARENT_DIR}" \
            --bind "$(pwd)/license.txt:/usr/local/freesurfer/license.txt" \
            --bind "$(pwd)":/app \
            --pwd /app \
            docker://brainlife/freesurfer:7.1.0 \
            bash -c "SUBJECTS_DIR=/app/${WORK_DIR} segmentThalamicNuclei.sh freesurfer_subject /app/${WORK_DIR}"
        # Copy the result back into the freesurfer directory
        cp "${WORK_DIR}/freesurfer_subject/mri/ThalamicNuclei.v12.T1.FSvoxelSpace.mgz" \
           "${FREESURFER}/mri/ThalamicNuclei.v12.T1.FSvoxelSpace.mgz"
        echo "[main] Thalamic nuclei segmentation done"
    else
        echo "[main] ThalamicNuclei.v12.T1.FSvoxelSpace.mgz found — skipping segmentation"
    fi
fi

# 5TT is not needed in tractogram mode (no ACT tracking)
if [ -z "$TRACTOGRAM" ]; then
    if [ -z "$FIVETT" ] || [ "$FORCE" == "true" ]; then
        FIVETT_OUT="${OUTPUT_DIR}/5tt/5tt.nii.gz"
        if [ -f "${FIVETT_OUT}" ] && [ "$FORCE" != "true" ]; then
            echo "[main] Skipping 5ttgen (${FIVETT_OUT} exists)"
            jq --arg p "${FIVETT_OUT}" '.fivett = $p' config.json > /tmp/cfg.json && mv /tmp/cfg.json config.json
        else
            echo "[main] Computing 5TT with brainlife/mrtrix3:3.0.0"
            mkdir -p "${WORK_DIR}" "${OUTPUT_DIR}/5tt"
            singularity exec -e \
                --bind "${PARENT_DIR}:${PARENT_DIR}" \
                --bind "$(pwd)":/app \
                --pwd /app \
                docker://brainlife/mrtrix3:3.0.0 \
                bash -c "
                    mrconvert ${T1} ${WORK_DIR}/t1.mif -force -nthreads ${NTHREADS} && \
                    5ttgen fsl ${WORK_DIR}/t1.mif ${WORK_DIR}/5tt.mif \
                        -nocrop -sgm_amyg_hipp \
                        -scratch ${WORK_DIR}/tmp \
                        -nthreads ${NTHREADS} \
                        -force && \
                    5tt2gmwmi ${WORK_DIR}/5tt.mif ${WORK_DIR}/gmwmi.mif -force && \
                    5tt2vis   ${WORK_DIR}/5tt.mif ${WORK_DIR}/5ttvis.mif -force && \
                    mrconvert ${WORK_DIR}/5tt.mif    -stride 1,2,3,4 ${FIVETT_OUT}                  -force && \
                    mrconvert ${WORK_DIR}/5ttvis.mif -stride 1,2,3,4 ${OUTPUT_DIR}/5tt/5ttvis.nii.gz -force
                "
            jq --arg p "${FIVETT_OUT}" '.fivett = $p' config.json > /tmp/cfg.json && mv /tmp/cfg.json config.json
            echo "[main] 5TT written to ${FIVETT_OUT}"
        fi
    fi
else
    echo "[main] Tractogram mode — skipping 5ttgen"
fi

singularity exec -e \
    --bind "${PARENT_DIR}:${PARENT_DIR}" \
    docker://gamorosino/app-optic-radiation-track:v1.1 \
    python3 main.py

# Generate product.json with QC images embedded as base64
bash generate_product_json.sh --compress QC product.json

# Generate figures manifest for Brainlife UI
bash generate_figures_manifest.sh QC .
